# LearnMate Environment Variables
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.

# ── IBM Cloud Credentials ─────────────────────────────────────────────────────
# Obtain from: cloud.ibm.com → Manage → Access (IAM) → API Keys → Create
IBM_API_KEY=

# Obtain from: watsonx.ai → Projects → your project → Manage → Details
IBM_PROJECT_ID=

# IBM watsonx.ai regional endpoint (default: us-south Dallas)
IBM_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model ID to use
IBM_MODEL=ibm/granite-3-3-8b-instruct

# ── Flask Settings ────────────────────────────────────────────────────────────
# Generate a strong random key, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 0 in production — never 1 on a public server
FLASK_DEBUG=0
